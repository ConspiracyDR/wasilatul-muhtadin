rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.active == true;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /readings/{readingId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();

      match /blocks/{blockId} {
        allow read: if true;
        allow create, update, delete: if isActiveAdmin();
      }
    }

    match /readingDrafts/{readingId} {
      allow read, create, update, delete: if isActiveAdmin();

      match /blocks/{blockId} {
        allow read, create, update, delete: if isActiveAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
